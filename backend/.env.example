# Port the Express server listens on
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/task_management

# Secret used to sign JWT auth tokens. Pick a long random string for production.
JWT_SECRET=replace_me_with_a_long_random_string

# Allowed CORS origin(s) for the frontend. Comma-separated for multiple origins.
# Defaults to http://localhost:4200 when unset.
# Example for production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:4200
